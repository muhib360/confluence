# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional: Supabase Service Role Key (for administrative tasks / bypass RLS if needed)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# LLM / AI Configuration
# Confluence utilizes OpenRouter or OpenAI-compatible endpoints (such as Alibaba Cloud DashScope / Qwen)
# Obtain an API key from https://openrouter.ai/keys or your chosen provider
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
